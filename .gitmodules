[submodule "codeserver/ubi9-python-3.12/prefetch-input/code-server"]
	path = codeserver/ubi9-python-3.12/prefetch-input/code-server
	url = https://github.com/coder/code-server.git
	shallow = true
# mongocli: v2.0.9 includes go.mongodb.org/mongo-driver v1.17.10 (CVE-2026-88031). Update via: cd path && git fetch && git checkout <sha-or-tag>
[submodule "prefetch-input/mongocli"]
	path = prefetch-input/mongocli
	url = https://github.com/mongodb/mongodb-cli
